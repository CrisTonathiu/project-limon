# ─────────────────────────────────────────────────────────────
# Environment variable strategy
#  - Local dev: copy to .env (never committed).
#  - preproduction/production: non-secret values are set on the
#    Cloud Run services in Terraform; secrets come from Secret Manager.
# ─────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
NODE_ENV=development

# API
API_PORT=4000
WORKER_PORT=4001
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Database (local docker). The app connects as a NON-superuser role so RLS applies.
DATABASE_URL=postgresql://limon_app:limon_app@localhost:5432/limon
# Migration role (owner). Used only by prisma migrate.
DATABASE_MIGRATION_URL=postgresql://limon_owner:limon_owner@localhost:5432/limon

# Auth: "identity-platform" on GCP, "dev" locally (signed dev tokens, NEVER allowed in production)
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=change-me-local-only
# Required for identity-platform: tokens must be issued for this project
GCP_PROJECT_ID=
# Background jobs. Empty locally: jobs run inside the api process instead of going through Pub/Sub
PUBSUB_JOBS_TOPIC=

# Tenant files (Cloud Storage). Signed URLs need Google credentials locally: gcloud auth application-default login
GCS_TENANT_BUCKET=limon-dev-tenant-assets

# Stripe (secrets → Secret Manager outside local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dashboard (apps/dashboard/.env.local; read by the server at request time)
#  AUTH_PROVIDER, APP_ENV and GCP_PROJECT_ID as above. The browser calls the dashboard's own
#  /api/v1 proxy, which forwards to API_BASE_URL with the session cookie.
DASHBOARD_ORIGIN=http://localhost:3000   # state-changing requests must come from this origin
# identity-platform only (public values: terraform output -json identity_platform)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Patient app (dev only; real builds get this from tenants/<slug>/app.json + EAS env)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
APP_TENANT=dev-tenant

# FatSecret Platform API (OAuth 2.0 client credentials). Server-side only; never EXPO_PUBLIC_.
# Requests only work from IPs whitelisted in the FatSecret developer portal.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Firebase web API key: public, but set by the build environment (terraform output -json identity_platform)
EXPO_PUBLIC_FIREBASE_API_KEY=