# ─────────────────────────────────────────────────────────────
# Environment variable strategy
#  - Local dev: copy to .env (never committed).
#  - staging/production: non-secret values come from ECS task
#    definitions; secrets come from AWS Secrets Manager.
# ─────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
NODE_ENV=development

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Database (local docker). The app connects as a NON-superuser role so RLS applies.
DATABASE_URL=postgresql://limon_app:limon_app@localhost:5432/limon
# Migration role (owner). Used only by prisma migrate.
DATABASE_MIGRATION_URL=postgresql://limon_owner:limon_owner@localhost:5432/limon

# Auth: "cognito" in AWS, "dev" locally (signed dev tokens, NEVER allowed in production)
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=change-me-local-only
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_NUTRITIONIST_CLIENT_ID=
COGNITO_PATIENT_CLIENT_ID=

# AWS
AWS_REGION=us-east-1
S3_TENANT_BUCKET=limon-dev-tenant-assets
SQS_JOBS_QUEUE_URL=

# Stripe (secrets → Secrets Manager outside local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Patient app (dev only; real builds get this from tenants/<slug>/app.json + EAS env)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
APP_TENANT=dev-tenant
