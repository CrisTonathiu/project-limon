# Block pushes to main: changes reach main through a pull request (CLAUDE.md).
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Pushing to main is blocked. Push a feat/ or chore/ branch and open a pull request." >&2
    exit 1
  fi
done
