// ─────────────────────────────────────────────────────────────────────────────
// Limon platform schema (foundation phase)
//
// Isolation rules (see docs/architecture/database.md):
//  1. Every tenant-owned table has tenant_id (uuid, NOT NULL, FK → tenants).
//  2. Cross-entity references inside a tenant use COMPOSITE foreign keys
//     (tenant_id, x_id) → (tenant_id, id) so a row can never point at another
//     tenant's row, even through an application bug.
//  3. Postgres Row-Level Security is enabled on every tenant-owned table
//     (migration 0002_rls). The runtime DB role cannot bypass it.
//  4. Tenant FKs are RESTRICT: tenant rows are never hard-deleted by cascade.
//     Tenant data deletion is an explicit, ordered job (DeleteTenantData).
//  5. Financial & audit records never cascade.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  // Generating into node_modules/.prisma (the default) doesn't survive `pnpm deploy --prod`
  // in the API/worker Docker images, since it's a side-effect location pnpm's dependency
  // pruning doesn't know about. A path inside the package itself is a normal file and does.
  output        = "../generated/client"
  // Prisma's own OpenSSL-version auto-detection fails silently inside the Alpine build stage
  // ("defaulting to openssl-1.1.x"), which is wrong for node:22-alpine (OpenSSL 3.x) and makes
  // the engine binary fail to load at runtime. Pin the correct target instead of guessing.
  // "native" keeps local generation (e.g. on macOS) working as before.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  PLATFORM_ADMIN
  NUTRITIONIST
  PATIENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELING
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum TenantAppStatus {
  DRAFT
  BUILDING
  SUBMITTED
  PUBLISHED
  DISABLED
  REMOVED
}

enum AppPlatform {
  IOS
  ANDROID
}

enum DatabaseMode {
  SHARED
  DEDICATED
}

enum PlatformSubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

/// Where a patient's payment is processed. Store billing is mandatory for digital
/// access sold inside the apps (Apple 3.1.1 / Google Play Billing); STRIPE is kept
/// for out-of-app sales (e.g. in-person or web checkout). See ADR-008.
enum PaymentProvider {
  APPLE_APP_STORE
  GOOGLE_PLAY
  STRIPE
}

enum PatientSubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  GRACE_PERIOD
  PAST_DUE
  CANCELED
  EXPIRED
  REFUNDED
}

/// Consents captured under LFPDPPP. Health data is sensitive personal data and
/// requires express consent, recorded with the exact document version shown.
enum ConsentKind {
  PRIVACY_NOTICE
  SENSITIVE_DATA
  TERMS_OF_SERVICE
}

/// Biological sex, as used by the energy equations (Mifflin-St Jeor).
enum BiologicalSex {
  FEMALE
  MALE
}

/// Physical activity level; each maps to a multiplier on BMR for the energy target.
enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

/// What the patient wants to work toward (@limon/types GoalIntention).
enum GoalIntention {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_WEIGHT
  NUTRITION_QUALITY
  BUILD_MUSCLE
  OTHER
}

/// The direction of the energy target an intention turns into.
enum WeightGoal {
  LOSE
  MAINTAIN
  GAIN
}

enum GoalPace {
  GENTLE
  MODERATE
  FAST
}

/// Screening: weight change in the last 3 months (more than 5 kg counts).
enum RecentWeightChange {
  STABLE
  LOST
  GAINED
  UNSURE
}

/// Why the starting target came out as it did (@limon/types GoalDecisionReason).
enum GoalDecisionReason {
  AS_CHOSEN
  MAINTAIN
  LEAN_GAIN
  OTHER
  RECENT_WEIGHT_LOSS
  DESIRED_WEIGHT_TOO_LOW
}

enum StoreAccountType {
  INDIVIDUAL
  ORGANIZATION
}

enum StoreAccountStatus {
  MAILBOX_CREATED
  ENROLLMENT_INVITED
  ENROLLED
  ACCESS_GRANTED
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Meal slots a recipe can fill. A recipe can fit several (e.g. a salad for lunch or dinner).
enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// Food groups of the Sistema Mexicano de Alimentos Equivalentes (SMAE), 5th ed. v2.0.
/// Swaps only happen within the same group. Spanish names from the book:
///   VEGETABLES = Verduras · FRUITS = Frutas
///   CEREALS_FAT_FREE / CEREALS_WITH_FAT = Cereales y tubérculos sin / con grasa
///   LEGUMES = Leguminosas
///   ANIMAL_VERY_LOW_FAT … ANIMAL_HIGH_FAT = Alimentos de origen animal de muy bajo / bajo / moderado / alto aporte de grasa
///   MILK_SKIM / MILK_SEMI_SKIM / MILK_WHOLE / MILK_WITH_SUGAR = Leche descremada / semidescremada / entera / con azúcar
///   FATS_WITHOUT_PROTEIN / FATS_WITH_PROTEIN = Aceites y grasas sin / con proteína
///   SUGARS_FAT_FREE / SUGARS_WITH_FAT = Azúcares sin / con grasa
///   FREE_FOODS = Alimentos libres de energía · ALCOHOLIC_BEVERAGES = Bebidas alcohólicas
enum SmaeGroup {
  VEGETABLES
  FRUITS
  CEREALS_FAT_FREE
  CEREALS_WITH_FAT
  LEGUMES
  ANIMAL_VERY_LOW_FAT
  ANIMAL_LOW_FAT
  ANIMAL_MODERATE_FAT
  ANIMAL_HIGH_FAT
  MILK_SKIM
  MILK_SEMI_SKIM
  MILK_WHOLE
  MILK_WITH_SUGAR
  FATS_WITHOUT_PROTEIN
  FATS_WITH_PROTEIN
  SUGARS_FAT_FREE
  SUGARS_WITH_FAT
  FREE_FOODS
  ALCOHOLIC_BEVERAGES
}

/// Shopping list sections, the way people shop in Mexico.
enum ShoppingCategory {
  PRODUCE // Frutas y verduras
  MEAT_FISH // Carnes y pescados
  DAIRY_EGGS // Lácteos y huevo
  BAKERY // Panadería y tortillería
  GROCERY // Abarrotes
  NUTS_SEEDS // Semillas
}

/// The unit an ingredient quantity is written in, for display. Every ingredient also
/// stores its weight in grams, which is what portions, swaps and the shopping list use.
enum IngredientUnit {
  G
  ML
  PIECE
  CUP
  TBSP
  TSP
}

/// How a shopping list item is counted: grams, millilitres or whole pieces.
enum ShoppingUnit {
  G
  ML
  PIECE
}

// ── Platform / tenancy ───────────────────────────────────────────────────────

model Tenant {
  id                 String                     @id @default(uuid()) @db.Uuid
  name               String
  slug               String                     @unique // mutable, display/routing only — NEVER a security identifier
  status             TenantStatus               @default(TRIAL)
  subscriptionStatus PlatformSubscriptionStatus @default(NONE) @map("subscription_status")
  // Data placement (tenant registry). Only SHARED/MAIN is implemented.
  databaseMode       DatabaseMode               @default(SHARED) @map("database_mode")
  databaseIdentifier String                     @default("MAIN") @map("database_identifier")
  /// Identity Platform tenant holding this practice's patient logins (ADR-006). Null until
  /// provisioned, and always null with dev auth.
  identityTenantId   String?                    @unique @map("identity_tenant_id")
  /// Platform-provisioned mailbox on the platform domain (e.g. maria@apps.<domain>).
  /// Used to enrol and operate this tenant's Apple/Google developer accounts (ADR-009).
  operationsEmail    String?                    @unique @map("operations_email")
  statusChangedAt    DateTime                   @default(now()) @map("status_changed_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  deletedAt          DateTime?                  @map("deleted_at")

  branding              TenantBranding?
  apps                  TenantApp[]
  users                 User[]
  nutritionists         Nutritionist[]
  patients              Patient[]
  recipes               Recipe[]
  recipeIngredients     RecipeIngredient[]
  mealPlans             MealPlan[]
  mealPlanMeals         MealPlanMeal[]
  mealFeedback          MealFeedback[]
  mealPlanMealSwaps     MealPlanMealSwap[]
  shoppingListChecks    ShoppingListCheck[]
  protocols             Protocol[]
  conversations         Conversation[]
  messages              Message[]
  platformSubscriptions PlatformSubscription[]
  patientSubscriptions  PatientSubscription[]
  payments              Payment[]
  auditLogs             AuditLog[]
  lifecycleEvents       TenantLifecycleEvent[]
  storeAccounts         TenantStoreAccount[]
  consents              PatientConsent[]
  inviteCodes           TenantInviteCode[]
  features              TenantFeature[]
  patientProfiles       PatientProfile[]
  patientDislikedFoods  PatientDislikedFood[]
  goalRules             TenantGoalRules[]
  patientGoals          PatientGoal[]
  bodyLogs              BodyLog[]
  waterIntakes          WaterIntake[]
  waterSettings         WaterSettings[]

  @@map("tenants")
}

/// Runtime branding — served by the API, changeable without a store release.
model TenantBranding {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  appName        String   @map("app_name")
  logoKey        String?  @map("logo_key") // S3 key, not a URL
  primaryColor   String   @default("#2E7D32") @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  supportEmail   String?  @map("support_email")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_brandings")
}

/// A store application (one row per platform). Lifecycle independent of Tenant.status.
model TenantApp {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  platform    AppPlatform
  /// Public, non-secret identifier baked into the build. Identifies context, NOT authorization.
  appKey      String          @unique @map("app_key")
  appName     String          @map("app_name")
  bundleId    String?         @unique @map("bundle_id") // iOS
  packageName String?         @unique @map("package_name") // Android
  appStoreId  String?         @map("app_store_id")
  playStoreId String?         @map("play_store_id")
  status      TenantAppStatus @default(DRAFT)
  version     String?
  buildNumber Int?            @map("build_number")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, platform])
  @@index([tenantId])
  @@map("tenant_apps")
}

/// Per-tenant feature flags (modules and add-ons), switched on by the platform team.
/// `featureKey` values are defined in @limon/types FeatureKey; stored as text so new
/// add-ons don't need a migration. A missing row means the feature is off.
model TenantFeature {
  tenantId   String   @map("tenant_id") @db.Uuid
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(false)
  /// Optional per-tenant settings for the feature.
  config     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, featureKey])
  @@map("tenant_features")
}

/// Single-use code that lets ONE pre-registered patient create their account in their
/// nutritionist's app. Required when the tenant's `invite_only` feature is on.
/// Checked before sign-up through app_invite_code_is_valid() (exact match only, never
/// listed) and redeemed inside the tenant's transaction at registration.
model TenantInviteCode {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// The pre-registered patient this code activates.
  patientId  String    @map("patient_id") @db.Uuid
  /// Stored normalized (upper case).
  code       String    @unique
  active     Boolean   @default(true)
  expiresAt  DateTime? @map("expires_at")
  redeemedAt DateTime? @map("redeemed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Operational: deleting a patient removes their pending invites.
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("tenant_invite_codes")
}

/// The developer account each tenant app is published from. One per store per tenant.
/// The account is legally the nutritionist's; the platform holds an operations mailbox
/// and delegated App Store Connect / Play Console access to run builds and submissions.
model TenantStoreAccount {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  platform          AppPlatform
  accountType       StoreAccountType   @default(INDIVIDUAL) @map("account_type")
  /// Mailbox used for the developer account (platform-provisioned, tenant-owned account).
  accountEmail      String             @map("account_email")
  /// Apple Team ID / Google Play developer ID once enrolment completes.
  externalAccountId String?            @map("external_account_id")
  status            StoreAccountStatus @default(MAILBOX_CREATED)
  /// Credentials live in Secrets Manager; only the reference is stored here.
  apiCredentialRef  String?            @map("api_credential_ref")
  enrolledAt        DateTime?          @map("enrolled_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, platform])
  @@index([tenantId])
  @@map("tenant_store_accounts")
}

/// Append-only record of tenant status transitions (who/when/why).
model TenantLifecycleEvent {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  fromStatus          TenantStatus @map("from_status")
  toStatus            TenantStatus @map("to_status")
  reason              String
  actorId             String?      @map("actor_id") @db.Uuid
  effectiveAt         DateTime     @default(now()) @map("effective_at")
  scheduledDeletionAt DateTime?    @map("scheduled_deletion_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, effectiveAt])
  @@map("tenant_lifecycle_events")
}

// ── Identity ─────────────────────────────────────────────────────────────────

/// Application user. Identity Platform proves identity; this row decides tenant + role.
/// PLATFORM_ADMIN users have tenant_id = NULL.
model User {
  id            String     @id @default(uuid()) @db.Uuid
  authUserId    String     @unique @map("auth_user_id") // Identity Platform uid (token `sub`)
  tenantId      String?    @map("tenant_id") @db.Uuid
  email         String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nutritionist Nutritionist?
  patient      Patient?

  /// Identity is tenant-scoped: the same email may be a patient of two nutritionists (ADR-006).
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@map("users")
}

model Nutritionist {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  isOwner   Boolean  @default(false) @map("is_owner")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("nutritionists")
}

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String?   @unique @map("user_id") @db.Uuid // null until the patient activates their app account
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  email       String?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user               User?                 @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  mealPlans          MealPlan[]
  mealFeedback       MealFeedback[]
  conversations      Conversation[]
  subscriptions      PatientSubscription[]
  consents           PatientConsent[]
  inviteCodes        TenantInviteCode[]
  profile            PatientProfile?
  goal               PatientGoal?
  bodyLogs           BodyLog[]
  waterIntakes       WaterIntake[]
  waterSettings      WaterSettings?
  shoppingListChecks ShoppingListCheck[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("patients")
}

/// Answers from the patient's onboarding questionnaire, editable from their profile.
/// Health data (LFPDPPP sensitive data): never log it or put it in audit metadata.
/// Birth date lives on Patient.dateOfBirth, not here.
model PatientProfile {
  patientId               String        @id @map("patient_id") @db.Uuid
  tenantId                String        @map("tenant_id") @db.Uuid
  sex                     BiologicalSex
  heightCm                Int           @map("height_cm")
  /// Weight given at onboarding or last profile edit. Weight logs (goal tracker) come later.
  weightKg                Float         @map("weight_kg")
  activityLevel           ActivityLevel @map("activity_level")
  mealsPerDay             Int           @map("meals_per_day")
  /// Pregnant or breastfeeding: no automatic energy target, the nutritionist decides.
  pregnantOrBreastfeeding Boolean       @default(false) @map("pregnant_or_breastfeeding")
  /// @limon/types Allergen keys, stored as text so the list can grow without a migration.
  allergies               String[]      @default([])
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Operational data owned by the patient: deleting a patient removes their profile.
  patient       Patient               @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  dislikedFoods PatientDislikedFood[]

  @@unique([tenantId, patientId])
  @@map("patient_profiles")
}

/// A clinic's goal rules, written by its nutritionist at onboarding and loaded by our team
/// (`admin goal-rules`). Never edited in place: each change is a new version, and the latest
/// one applies. `rules` is @limon/validation GoalRules, which may only be stricter than the
/// platform's guardrails.
model TenantGoalRules {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  version   Int
  rules     Json
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@map("tenant_goal_rules")
}

/// The patient's goal: what they asked for and the starting target the rules chose. One row
/// per patient, replaced when they change it (each change is in the audit log). The target's
/// kcal follow profile edits; the decision (direction, pace, reason) only changes here.
model PatientGoal {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  patientId          String             @map("patient_id") @db.Uuid
  intention          GoalIntention
  /// The pace the patient picked (lose and gain only).
  pace               GoalPace?
  /// How many kg they'd like to lose or gain, if they said. Always positive.
  desiredChangeKg    Float?             @map("desired_change_kg")
  otherText          String?            @map("other_text")
  recentWeightChange RecentWeightChange @map("recent_weight_change")
  decidedGoal        WeightGoal         @map("decided_goal")
  decidedPace        GoalPace?          @map("decided_pace")
  reason             GoalDecisionReason
  /// The patient's weight when they set the goal: where the progress bar starts.
  startWeightKg      Float              @map("start_weight_kg")
  /// The rules the decision used: "platform-1" or "clinic-3".
  rulesVersion       String             @map("rules_version")
  decidedAt          DateTime           @default(now()) @map("decided_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Operational data owned by the patient: deleting a patient removes their goal.
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, patientId])
  @@map("patient_goals")
}

/// One day of the patient's weigh-in and body measurements (goal tracker). Every value is
/// optional, but a row has at least one. The latest weight is also the profile's weight.
/// Health data: never log it or put it in audit metadata.
model BodyLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  /// The day on the patient's calendar (America/Mexico_City).
  date       DateTime @db.Date
  weightKg   Float?   @map("weight_kg")
  waistCm    Float?   @map("waist_cm")
  hipCm      Float?   @map("hip_cm")
  chestCm    Float?   @map("chest_cm")
  armCm      Float?   @map("arm_cm")
  thighCm    Float?   @map("thigh_cm")
  bodyFatPct Float?   @map("body_fat_pct")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, patientId, date])
  @@map("body_logs")
}

/// A glass (or bottle) of water the patient logged (water tracker). One row per tap, so it can be undone.
model WaterIntake {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  /// The day on the patient's calendar (America/Mexico_City) when it was logged.
  date      DateTime @db.Date
  amountMl  Int      @map("amount_ml")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, patientId, date])
  @@map("water_intakes")
}

/// The patient's own daily water target. No row means the default (35 ml per kg of body weight).
model WaterSettings {
  patientId String   @id @map("patient_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  targetMl  Int      @map("target_ml")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, patientId])
  @@map("water_settings")
}

/// A catalog food the patient doesn't want in their meal plans (onboarding / profile).
/// The meal plan generator leaves out recipes that use any of them.
model PatientDislikedFood {
  tenantId  String   @map("tenant_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  foodId    String   @map("food_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Part of the profile: replaced with it on every save, erased with it on account deletion.
  profile PatientProfile @relation(fields: [tenantId, patientId], references: [tenantId, patientId], onDelete: Cascade)
  food    Food           @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@id([tenantId, patientId, foodId])
  @@index([foodId])
  @@map("patient_disliked_foods")
}

// ── Nutrition domain ─────────────────────────────────────────────────────────
//
// Food and the default recipe library are platform reference data: shared by every
// tenant, no tenant_id, no RLS, read-only for the app role (curated by our team with
// the owner role). Each tenant gets its own editable copy of the default recipes.
//
// FatSecret's terms only let us store its ids, so no nutrient value is stored here:
// macros are computed on demand from fatsecret_food_cache (≤ 24 h) and the grams below.

/// A food in the platform catalog, curated by our team from FatSecret (MX) and the SMAE book
/// (private/foods.csv, loaded with `pnpm --filter @limon/database admin foods`).
model Food {
  id                 String           @id @default(uuid()) @db.Uuid
  /// Stable curation key from the CSV (e.g. "jitomate"). Re-imports match on it, and recipe imports refer to foods by it.
  key                String           @unique
  /// Spanish display name, written by us (not FatSecret's).
  name               String
  fatsecretFoodId    String           @map("fatsecret_food_id")
  /// The FatSecret serving the nutrients are read from. Its size in grams comes with the
  /// food from FatSecret (cached ≤ 24 h), so it isn't stored here.
  fatsecretServingId String           @map("fatsecret_serving_id")
  /// SMAE group and the grams of this food in one equivalent, entered by hand from the book.
  /// Both null for foods SMAE doesn't list (e.g. garlic); those can't be swapped.
  smaeGroup          SmaeGroup?       @map("smae_group")
  gramsPerEquivalent Float?           @map("grams_per_equivalent")
  shoppingCategory   ShoppingCategory @map("shopping_category")
  /// @limon/types Allergen keys this food contains, matched against patient_profiles.allergies.
  allergens          String[]         @default([])
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  recipeIngredients        RecipeIngredient[]
  defaultRecipeIngredients DefaultRecipeIngredient[]
  dislikedBy               PatientDislikedFood[]
  mealSwaps                MealPlanMealSwap[]
  shoppingListChecks       ShoppingListCheck[]

  @@index([fatsecretFoodId])
  @@index([smaeGroup])
  @@map("foods")
}

/// The platform's default recipe library. Copied into each tenant's `recipes` when the
/// tenant is created; later changes here never touch those copies.
model DefaultRecipe {
  id           String     @id @default(uuid()) @db.Uuid
  /// Stable curation key from private/recipes.csv (e.g. "molletes"). Re-imports match on it.
  key          String     @unique
  title        String
  description  String?
  mealTypes    MealType[] @map("meal_types")
  servings     Int
  totalMinutes Int?       @map("total_minutes")
  /// S3 object key of the photo.
  imageKey     String?    @map("image_key")
  tags         String[]   @default([])
  steps        String[]   @default([])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  ingredients DefaultRecipeIngredient[]
  copies      Recipe[]

  @@map("default_recipes")
}

model DefaultRecipeIngredient {
  id              String         @id @default(uuid()) @db.Uuid
  defaultRecipeId String         @map("default_recipe_id") @db.Uuid
  foodId          String         @map("food_id") @db.Uuid
  /// Order in the recipe.
  position        Int
  quantity        Float
  unit            IngredientUnit
  /// The quantity in grams, for the whole recipe (all servings).
  grams           Float
  /// e.g. "picado", "sin semillas".
  note            String?

  defaultRecipe DefaultRecipe @relation(fields: [defaultRecipeId], references: [id], onDelete: Cascade)
  food          Food          @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([defaultRecipeId, position])
  @@index([foodId])
  @@map("default_recipe_ingredients")
}

/// A tenant's recipe: a copy of a default recipe (possibly edited) or one of their own.
model Recipe {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @map("tenant_id") @db.Uuid
  /// The default recipe this was copied from, for traceability. Null for the tenant's own.
  sourceDefaultRecipeId String?    @map("source_default_recipe_id") @db.Uuid
  title                 String
  description           String?
  mealTypes             MealType[] @map("meal_types")
  servings              Int
  totalMinutes          Int?       @map("total_minutes")
  /// S3 object key of the photo.
  imageKey              String?    @map("image_key")
  tags                  String[]   @default([])
  steps                 String[]   @default([])
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceDefaultRecipe DefaultRecipe?     @relation(fields: [sourceDefaultRecipeId], references: [id], onDelete: SetNull)
  ingredients         RecipeIngredient[]
  mealPlanMeals       MealPlanMeal[]
  feedback            MealFeedback[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceDefaultRecipeId])
  @@map("recipes")
}

model RecipeIngredient {
  id       String         @id @default(uuid()) @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  recipeId String         @map("recipe_id") @db.Uuid
  foodId   String         @map("food_id") @db.Uuid
  /// Order in the recipe.
  position Int
  quantity Float
  unit     IngredientUnit
  /// The quantity in grams, for the whole recipe (all servings).
  grams    Float
  /// e.g. "picado", "sin semillas".
  note     String?

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipe Recipe             @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Cascade)
  food   Food               @relation(fields: [foodId], references: [id], onDelete: Restrict)
  swaps  MealPlanMealSwap[]

  @@unique([tenantId, id])
  @@unique([tenantId, recipeId, position])
  @@index([foodId])
  @@map("recipe_ingredients")
}

// ── Meal plans ───────────────────────────────────────────────────────────────
//
// Built by the generator (apps/api/src/modules/meal-plans) from the tenant's recipes.
// Like recipes, a plan stores no nutrient values: only recipe ids and servings. Day
// totals are recomputed from fatsecret_food_cache when the plan is read.

/// A patient's plan for one week (Monday to Sunday).
model MealPlan {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  /// The Monday the plan starts on, in the patient's time zone (es-MX).
  weekStart DateTime @map("week_start") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Operational data owned by the patient: deleting a patient removes their plans.
  patient Patient        @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  meals   MealPlanMeal[]

  @@unique([tenantId, id])
  @@unique([tenantId, patientId, weekStart])
  @@map("meal_plans")
}

/// One meal slot of a plan day. Regenerating a day replaces that date's rows.
model MealPlanMeal {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  mealPlanId String   @map("meal_plan_id") @db.Uuid
  date       DateTime @db.Date
  /// Order within the day (0 = first meal), from the patient's meals per day.
  slot       Int
  mealType   MealType @map("meal_type")
  /// Null when no recipe passed the patient's filters for this slot. Set together with servings.
  recipeId   String?  @map("recipe_id") @db.Uuid
  /// Portion factor: recipe servings the patient eats in this meal (0.5–2.5, in 0.05 steps).
  servings   Float?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mealPlan MealPlan           @relation(fields: [tenantId, mealPlanId], references: [tenantId, id], onDelete: Cascade)
  // A recipe used in a plan can't be deleted: the recipe editor (dashboard) will have to archive instead.
  recipe   Recipe?            @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Restrict)
  swaps    MealPlanMealSwap[]

  @@unique([tenantId, id])
  @@unique([tenantId, mealPlanId, date, slot])
  @@index([tenantId, recipeId])
  @@map("meal_plan_meals")
}

/// An ingredient of one plan meal swapped for an equivalent food from the same SMAE group.
/// Only the food is stored: its grams follow from the equivalents when the meal is read, and
/// the recipe itself never changes. Regenerating the day removes the meal, and its swaps with it.
model MealPlanMealSwap {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  mealPlanMealId     String   @map("meal_plan_meal_id") @db.Uuid
  recipeIngredientId String   @map("recipe_ingredient_id") @db.Uuid
  /// The food eaten instead of the recipe ingredient's.
  foodId             String   @map("food_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mealPlanMeal     MealPlanMeal     @relation(fields: [tenantId, mealPlanMealId], references: [tenantId, id], onDelete: Cascade)
  recipeIngredient RecipeIngredient @relation(fields: [tenantId, recipeIngredientId], references: [tenantId, id], onDelete: Cascade)
  food             Food             @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([tenantId, mealPlanMealId, recipeIngredientId])
  @@index([foodId])
  @@map("meal_plan_meal_swaps")
}

/// A patient's rating of a recipe in a given week. For now only favourites (♥, rating 1),
/// which the generator boosts. Kept as training data for a future preference model.
model MealFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  /// 1 = favourite. -1 is reserved for a later "don't show me this again"; the column is checked to -1..1.
  rating    Int      @db.SmallInt
  /// The week of the plan the patient rated it from (its Monday).
  weekStart DateTime @map("week_start") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  recipe  Recipe  @relation(fields: [tenantId, recipeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, patientId, recipeId, weekStart])
  @@index([tenantId, recipeId])
  @@map("meal_feedback")
}

/// An item the patient checked off their shopping list for a week. The list itself isn't
/// stored: it is worked out from the week's plan on every read. `amount` is what the list
/// asked for when it was checked, so an item shows unchecked again if a plan change raises it.
model ShoppingListCheck {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  patientId String       @map("patient_id") @db.Uuid
  /// The plan's Monday.
  weekStart DateTime     @map("week_start") @db.Date
  foodId    String       @map("food_id") @db.Uuid
  unit      ShoppingUnit
  amount    Float
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  food    Food    @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([tenantId, patientId, weekStart, foodId])
  @@index([foodId])
  @@map("shopping_list_checks")
}

// ── Placeholders (tables exist, no business logic yet) ───────────────────────

model Protocol {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("protocols")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient  Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  messages Message[]

  @@unique([tenantId, id])
  @@index([tenantId, patientId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderUserId   String?  @map("sender_user_id") @db.Uuid // null = AI assistant
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

// ── Billing (two distinct relationships — never mixed) ───────────────────────

/// Nutritionist → Platform (Stripe Billing).
model PlatformSubscription {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @map("tenant_id") @db.Uuid
  stripeCustomerId     String                     @map("stripe_customer_id")
  stripeSubscriptionId String?                    @unique @map("stripe_subscription_id")
  status               PlatformSubscriptionStatus
  currentPeriodEnd     DateTime?                  @map("current_period_end")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("platform_subscriptions")
}

/// Patient → Nutritionist. The patient pays for access to their nutritionist's programme.
/// Provider-agnostic: Apple/Google store billing for in-app purchases, Stripe for
/// out-of-app sales. Entitlement (does this patient have access?) is derived from this row.
model PatientSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  tenantId               String                    @map("tenant_id") @db.Uuid
  patientId              String                    @map("patient_id") @db.Uuid
  provider               PaymentProvider
  /// Apple originalTransactionId / Google purchaseToken / Stripe subscription id.
  providerSubscriptionId String                    @map("provider_subscription_id")
  /// Store product identifier or Stripe price id.
  productId              String                    @map("product_id")
  status                 PatientSubscriptionStatus @default(PENDING)
  currentPeriodEnd       DateTime?                 @map("current_period_end")
  cancelAtPeriodEnd      Boolean                   @default(false) @map("cancel_at_period_end")
  /// Stripe Connect account (STRIPE provider only).
  stripeAccountId        String?                   @map("stripe_account_id")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Financial: patient deletion must NOT silently remove billing history.
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([provider, providerSubscriptionId])
  @@index([tenantId, patientId, status])
  @@map("patient_subscriptions")
}

/// Express consent record (LFPDPPP). Retained as a legal record; never cascade-deleted.
model PatientConsent {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  patientId       String      @map("patient_id") @db.Uuid
  kind            ConsentKind
  /// Version of the exact document the patient accepted (e.g. "aviso-privacidad-2026-09").
  documentVersion String      @map("document_version")
  acceptedAt      DateTime    @default(now()) @map("accepted_at")
  revokedAt       DateTime?   @map("revoked_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, patientId, kind])
  @@map("patient_consents")
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  kind        String // PLATFORM | PATIENT
  amountMinor Int      @map("amount_minor")
  currency    String   @db.Char(3)
  status      String
  createdAt   DateTime @default(now()) @map("created_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@unique([tenantId, id])
  @@map("payments")
}

model PaymentTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  stripeObjectId String   @unique @map("stripe_object_id")
  type           String
  amountMinor    Int      @map("amount_minor")
  createdAt      DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@map("payment_transactions")
}

// ── Audit ────────────────────────────────────────────────────────────────────

/// Append-only (UPDATE/DELETE revoked for the app role in 0002_rls).
/// metadata must not contain patient health data — IDs and field names only.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid // null for platform-level events
  userId       String?  @map("user_id") @db.Uuid // no FK: survives user deletion
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// FatSecret food data (normalized FoodDetail), cached for at most 24 h — FatSecret's
/// terms only allow storing ids longer. Shared by every tenant (not tenant data, no
/// tenant_id). Refreshed every few hours by the worker; rows past `expiresAt` are
/// never served and are deleted by the same job (see apps/api/src/jobs/food-cache-maintenance.ts).
model FatSecretFoodCache {
  fatsecretFoodId String   @map("fatsecret_food_id")
  /// "" on the Basic plan (US, English); e.g. "MX" / "es" on Premier.
  region          String   @default("")
  language        String   @default("")
  food            Json
  fetchedAt       DateTime @map("fetched_at")
  /// fetchedAt + 24 h. Hard limit from FatSecret's terms.
  expiresAt       DateTime @map("expires_at")
  /// Only foods used recently keep being refreshed.
  lastUsedAt      DateTime @map("last_used_at")

  @@id([fatsecretFoodId, region, language])
  @@index([expiresAt])
  @@index([region, language, fetchedAt])
  @@map("fatsecret_food_cache")
}
